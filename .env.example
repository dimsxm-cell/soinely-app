NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_SOLO_ANNUEL=
STRIPE_PRICE_ID_CABINET=
STRIPE_PRICE_ID_CABINET_ANNUEL=

# Calcul des distances par la route, pour les indemnités kilométriques.
# Clé gratuite : https://openrouteservice.org/dev/#/signup (2 000 requêtes/jour).
# Facultative : sans elle, les distances sont estimées à partir des coordonnées,
# à 5-10 % près, et restent corrigeables à la main.
OPENROUTESERVICE_API_KEY=

# Affiche le bouton « Se connecter avec Apple ». À poser à 1 le jour où le
# fournisseur Apple est activé dans Supabase — ce qui suppose un compte Apple
# Developer payant. Sans lui, le bouton renverrait « Unsupported provider ».
NEXT_PUBLIC_AUTH_APPLE=

# Synthèse IA des réponses d'Ely, à partir de fiches déjà validées.
# Clé : https://console.anthropic.com/settings/keys
# Facultative : sans elle, Ely affiche directement la meilleure fiche
# trouvée par la recherche, comme avant ce chantier.
ANTHROPIC_API_KEY=
